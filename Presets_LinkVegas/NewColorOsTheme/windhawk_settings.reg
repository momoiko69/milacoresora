Windows Registry Editor Version 5.00

[HKEY_LOCAL_MACHINE\SOFTWARE\Windhawk\Engine\Mods\windows-11-taskbar-styler\Settings]
"taskbarHeight"=dword:00000030
"taskbarRadius"=dword:00000014
"taskbarBackground"="#140A12"
"accentColor"="#F472B6"
"borderColor"="#EC4899"
"isFloating"="true"

[HKEY_LOCAL_MACHINE\SOFTWARE\Windhawk\Engine\Mods\windows-11-file-explorer-styler\Settings]
"acrylicTabs"=dword:00000001
"glassBackground"="#140A12"
"tabAccent"="#F472B6"

[HKEY_LOCAL_MACHINE\SOFTWARE\Windhawk\Engine\Mods\translucent-windows\Settings]
"transparencyType"=dword:00000002
"blurOpacity"=dword:00000050
