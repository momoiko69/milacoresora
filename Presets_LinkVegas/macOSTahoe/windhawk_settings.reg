Windows Registry Editor Version 5.00

[HKEY_LOCAL_MACHINE\SOFTWARE\Windhawk\Engine\Mods\windows-11-taskbar-styler\Settings]
"theme"="TranslucentTaskbar"
"clickThroughTaskbar"=dword:00000001
"xamlDiagnosticsHandling"="alert"
"taskbarHeight"=dword:00000030
"taskbarRadius"=dword:0000001a
"taskbarBackground"="#071326"
"accentColor"="#007AFF"
"borderColor"="#38BDF8"
"isFloating"="true"

[HKEY_LOCAL_MACHINE\SOFTWARE\Windhawk\Engine\Mods\windows-11-start-menu-styler\Settings]
"theme"="LiquidGlass2"
"disableNewStartMenuLayout"="default"

[HKEY_LOCAL_MACHINE\SOFTWARE\Windhawk\Engine\Mods\windows-11-settings-styler\Settings]
"theme"="Translucent Settings11"

[HKEY_LOCAL_MACHINE\SOFTWARE\Windhawk\Engine\Mods\windows-11-notification-center-styler\Settings]
"theme"="LiquidGlass"

[HKEY_LOCAL_MACHINE\SOFTWARE\Windhawk\Engine\Mods\windows-11-file-explorer-styler\Settings]
"theme"="OS26 Liquid Glass"
"backgroundTranslucentEffect"="acrylic"
"backgroundTranslucentEffectRegion"="entireWindow"
"acrylicTabs"=dword:00000001
"glassBackground"="#071326"
"tabAccent"="#007AFF"

[HKEY_LOCAL_MACHINE\SOFTWARE\Windhawk\Engine\Mods\translucent-windows\Settings]
"transparencyType"=dword:00000002
"blurOpacity"=dword:00000050

