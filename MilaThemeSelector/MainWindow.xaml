<Window x:Class="MilaThemeSelector.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MilaCore — Universal Theme Selector (Windows OS &amp; Applications)"
        Icon="app_icon.ico"
        Height="490" Width="860" MinHeight="420" MinWidth="740"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Background="#0B0E14"
        Foreground="#F1F5F9"
        FontFamily="Segoe UI">

    <Window.Resources>
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="6"/>
            <Setter Property="Background" Value="#111827"/>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- TOP BAR -->
        <Border Grid.Row="0" Background="#111722" CornerRadius="8" BorderBrush="#1E293B" BorderThickness="1" Padding="12,8" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="30" Height="30" CornerRadius="6" Background="#162032" BorderBrush="#38BDF8" BorderThickness="1" Margin="0,0,10,0">
                        <Image Source="app_icon.ico" Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="MILACORE UNIVERSAL THEME SELECTOR" FontWeight="Bold" FontSize="13" Foreground="#38BDF8"/>
                        <TextBlock Text="Unified Windows 11 OS Shell &amp; Application Customization" FontSize="10.5" Foreground="#94A3B8"/>
                    </StackPanel>
                </StackPanel>

                <!-- Category Tabs -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <RadioButton x:Name="TabMila" Content="🌟 Mila Universe" IsChecked="True" Checked="Category_Changed"
                                 Foreground="#F1F5F9" Margin="0,0,12,0" Cursor="Hand" VerticalAlignment="Center"/>
                    <RadioButton x:Name="TabLinkVegas" Content="🌐 LinkVegas Overhauls" Checked="Category_Changed"
                                 Foreground="#F1F5F9" Margin="0,0,12,0" Cursor="Hand" VerticalAlignment="Center"/>
                    <RadioButton x:Name="TabWinThemes" Content="🪟 Windows OS Themes" Checked="Category_Changed"
                                 Foreground="#38BDF8" FontWeight="SemiBold" Cursor="Hand" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- MAIN SPLIT CONTENT -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT: SEARCH & THEME LIST -->
            <Border Grid.Column="0" Background="#111722" CornerRadius="8" BorderBrush="#1E293B" BorderThickness="1" Margin="0,0,10,0" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Search Box -->
                    <Border Grid.Row="0" Background="#0A0E17" CornerRadius="6" BorderBrush="#243248" BorderThickness="1" Padding="8,4" Margin="0,0,0,8">
                        <Grid>
                            <TextBlock x:Name="TxtPlaceholder" Text="🔍 Search theme by name or style..." Foreground="#64748B" FontSize="11" VerticalAlignment="Center" IsHitTestVisible="False"/>
                            <TextBox x:Name="TxtSearch" Background="Transparent" Foreground="#F8FAFC" BorderThickness="0" FontSize="11.5" TextChanged="TxtSearch_TextChanged" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Theme ListBox -->
                    <ListBox x:Name="LstThemes" Grid.Row="1" Background="Transparent" BorderThickness="0" 
                             SelectionChanged="LstThemes_SelectionChanged" 
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,0,0,4"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Bd" CornerRadius="6" Background="#162032" BorderBrush="#1F2E45" BorderThickness="1" Padding="8,6">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="BorderBrush" Value="#38BDF8"/>
                                                    <Setter TargetName="Bd" Property="Background" Value="#1C293E"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Bd" Property="BorderBrush" Value="#38BDF8"/>
                                                    <Setter TargetName="Bd" Property="Background" Value="#1E3A5F"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="8" Height="24" CornerRadius="3" Background="{Binding AccentBrush}" Margin="0,0,8,0"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="11.5" Foreground="#F8FAFC"/>
                                        <TextBlock Text="{Binding Category}" FontSize="9.5" Foreground="#94A3B8"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- RIGHT: THEME PREVIEW & APPLICATION CONTROLS -->
            <Border Grid.Column="1" Background="#111722" CornerRadius="8" BorderBrush="#1E293B" BorderThickness="1" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Theme Header -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,8">
                        <TextBlock x:Name="LblThemeTitle" Text="Select a Theme" FontSize="17" FontWeight="Bold" Foreground="#38BDF8"/>
                        <TextBlock x:Name="LblThemeCategory" Text="Category: Ready for selection" FontSize="10.5" Foreground="#94A3B8" Margin="0,2,0,0"/>
                        <TextBlock x:Name="LblThemeDesc" Text="Pick a theme from the left pane to view its design architecture." FontSize="10.5" Foreground="#CBD5E1" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    </StackPanel>

                    <!-- Color Swatches -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
                        <Border x:Name="SwatchBg" Width="60" Height="28" CornerRadius="5" Background="#161F2E" BorderBrush="#334155" BorderThickness="1" Margin="0,0,8,0">
                            <TextBlock x:Name="TxtHexBg" Text="BG" FontSize="9" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#CBD5E1"/>
                        </Border>
                        <Border x:Name="SwatchAccent" Width="60" Height="28" CornerRadius="5" Background="#38BDF8" BorderBrush="#334155" BorderThickness="1" Margin="0,0,8,0">
                            <TextBlock x:Name="TxtHexAccent" Text="ACCENT" FontSize="9" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#000000" FontWeight="Bold"/>
                        </Border>
                        <Border x:Name="SwatchBorder" Width="60" Height="28" CornerRadius="5" Background="#1E293B" BorderBrush="#334155" BorderThickness="1" Margin="0,0,8,0">
                            <TextBlock x:Name="TxtHexBorder" Text="BORDER" FontSize="9" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#CBD5E1"/>
                        </Border>
                        <Border x:Name="BadgeStyle" CornerRadius="5" Background="#1E293B" Padding="8,4" Margin="6,0,0,0">
                            <TextBlock x:Name="TxtRadiusInfo" Text="Radius: 14px • Floating Dock" FontSize="10" Foreground="#38BDF8" FontWeight="SemiBold"/>
                        </Border>
                    </StackPanel>

                    <!-- LIVE PREVIEW CANVAS -->
                    <Border Grid.Row="2" Background="#0A0E17" CornerRadius="6" BorderBrush="#1F293D" BorderThickness="1" Padding="10" Margin="0,0,0,10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Mini App Window Mockup -->
                            <Border Grid.Row="0" x:Name="PreviewWindow" Background="#111827" CornerRadius="6" BorderBrush="#38BDF8" BorderThickness="1" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="20"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <!-- Window Titlebar -->
                                    <Border Grid.Row="0" Background="#161F2E" CornerRadius="5,5,0,0" Padding="6,0">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Ellipse Width="7" Height="7" Fill="#EF4444" Margin="0,0,3,0"/>
                                            <Ellipse Width="7" Height="7" Fill="#F59E0B" Margin="0,0,3,0"/>
                                            <Ellipse Width="7" Height="7" Fill="#10B981" Margin="0,0,6,0"/>
                                            <TextBlock Text="Windows 11 &amp; MilaCore Unified Theme Preview" FontSize="9" Foreground="#94A3B8"/>
                                        </StackPanel>
                                    </Border>
                                    <!-- Window Body -->
                                    <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock Text="Active DWM Acrylic Blur, Accent Palette &amp; Shell Styling" FontSize="10.5" Foreground="#CBD5E1" HorizontalAlignment="Center"/>
                                        <TextBlock x:Name="TxtPreviewAccent" Text="Accent Color Sync (Windows &amp; Apps)" FontSize="9.5" Foreground="#38BDF8" HorizontalAlignment="Center" Margin="0,3,0,0" FontWeight="Bold"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Mini Taskbar Mockup -->
                            <Border Grid.Row="1" x:Name="PreviewTaskbar" Height="28" Width="220" CornerRadius="10" Background="#161F2E" BorderBrush="#38BDF8" BorderThickness="1" HorizontalAlignment="Center">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Border Width="14" Height="14" CornerRadius="3" Background="#38BDF8" Margin="0,0,5,0"/>
                                    <Border Width="14" Height="14" CornerRadius="3" Background="#22D3EE" Margin="0,0,5,0"/>
                                    <Border Width="14" Height="14" CornerRadius="3" Background="#64748B" Margin="0,0,5,0"/>
                                    <Border Width="14" Height="14" CornerRadius="3" Background="#64748B" Margin="0,0,5,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- APPLICATION SCOPE TOGGLES -->
                    <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,10">
                        <CheckBox x:Name="ChkApplyWindows" Content="Apply to Windows 11 Shell &amp; DWM Accent" IsChecked="True" Foreground="#F1F5F9" Margin="0,0,14,0" Cursor="Hand" FontSize="11"/>
                        <CheckBox x:Name="ChkApplyApps" Content="Apply to MilaCore Applications" IsChecked="True" Foreground="#F1F5F9" Cursor="Hand" FontSize="11"/>
                    </StackPanel>

                    <!-- ACTION BUTTONS -->
                    <Grid Grid.Row="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Button x:Name="BtnApply" Grid.Column="0" Content="⚡ APPLY THEME (WINDOWS OS &amp; APPS)" Height="34"
                                Background="#38BDF8" Foreground="#0B0E14" FontWeight="Bold" FontSize="11.5"
                                BorderThickness="0" Cursor="Hand" Click="BtnApply_Click" Margin="0,0,8,0">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </Button.Resources>
                        </Button>

                        <Button x:Name="BtnWinThemes" Grid.Column="1" Content="🪟 Win Personalize" Height="34" Padding="10,0"
                                Background="#162032" Foreground="#38BDF8" FontWeight="SemiBold" FontSize="11"
                                BorderBrush="#1F2E45" BorderThickness="1" Cursor="Hand" Click="BtnWinSettings_Click" Margin="0,0,8,0">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </Button.Resources>
                        </Button>

                        <Button x:Name="BtnRevert" Grid.Column="2" Content="🔄 Stock Windows" Height="34" Padding="10,0"
                                Background="#1E293B" Foreground="#94A3B8" FontWeight="SemiBold" FontSize="11"
                                BorderThickness="0" Cursor="Hand" Click="BtnRevert_Click">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- STATUS BAR -->
        <Border Grid.Row="2" Background="#111722" CornerRadius="5" BorderBrush="#1E293B" BorderThickness="1" Padding="8,4" Margin="0,8,0,0">
            <TextBlock x:Name="TxtStatus" Text="Ready. Select any theme to customize Windows 11 and MilaCore applications simultaneously." FontSize="10.5" Foreground="#94A3B8"/>
        </Border>
    </Grid>
</Window>
